{
  "name": "livre-moi.ca",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo Livre-moi.ca — covoiturage et cotransportage de colis (web, admin, mobile).",
  "workspaces": [
    "apps/*",
    "packages/*",
    "Tailwindadmin-nextjs/packages/nextauth"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@livre-moi/web --filter=@livre-moi/admin",
    "dev:web": "turbo run dev --filter=@livre-moi/web",
    "dev:admin": "turbo run dev --filter=@livre-moi/admin",
    "dev:mobile": "turbo run start --filter=@livre-moi/mobile",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@livre-moi/web",
    "build:admin": "turbo run build --filter=@livre-moi/admin",
    "lint": "turbo run lint",
    "start": "turbo run start --filter=@livre-moi/web"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.2"
}
